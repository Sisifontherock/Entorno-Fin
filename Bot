bot.py — Orquestador principal
Flujo: espera al minuto 4 → aplica 5 filtros → entra trade si pasan todos

import time
import logging
import os
from datetime import datetime, timezone

from binance_data import get_candles_1m
from filters import run_all_filters
from polymarket_client import find_active_market, place_buy_order, get_market_probability

logging.basicConfig(
    level=logging.INFO,
    format="%(asctime)s  %(levelname)s  %(message)s",
    datefmt="%Y-%m-%d %H:%M:%S"
)
log = logging.getLogger(__name__)

CAPITAL_PER_TRADE = float(os.getenv("CAPITAL_PER_TRADE", "10"))
MIN_PROBABILITY   = float(os.getenv("MIN_PROBABILITY", "0.97"))   # 97% mínimo
ENTRY_OFFSET_SEC  = int(os.getenv("ENTRY_OFFSET_SEC", "255"))      # min 4:15


def current_window_start() -> int:
    """Timestamp Unix del inicio de la ventana de 5 min activa."""
    return (int(time.time()) // 300) * 300


def sleep_until_entry():
    """
    Duerme hasta el segundo 255 de la ventana actual (minuto 4:15).
    Deja 45 segundos antes del cierre para ejecutar el trade.
    """
    now = time.time()
    window_start = (int(now) // 300) * 300
    target = window_start + ENTRY_OFFSET_SEC
    wait = target - now

    if wait <= 0:
        log.warning("Ya pasó el punto de entrada de esta ventana — esperando la próxima.")
        next_window = window_start + 300 + ENTRY_OFFSET_SEC
        wait = next_window - time.time()
        if wait < 0:
            return False

    log.info(f"Durmiendo {wait:.0f} segundos hasta minuto 4:15...")
    time.sleep(max(wait, 0))
    return True


def run():
    log.info("=" * 60)
    log.info(f"Bot iniciado  |  capital: ${CAPITAL_PER_TRADE}  |  prob. mínima: {MIN_PROBABILITY*100:.0f}%")

    ok = sleep_until_entry()
    if not ok:
        log.error("No se pudo calcular punto de entrada.")
        return

    window_ts = current_window_start()
    log.info(f"Ventana activa: {datetime.fromtimestamp(window_ts, tz=timezone.utc).strftime('%H:%M')} UTC")

    # 1. Obtener las últimas 5 velas de 1 minuto de Binance
    candles = get_candles_1m(symbol="BTCUSDT", limit=5)
    if not candles or len(candles) < 4:
        log.error("No se pudieron obtener velas de Binance.")
        return

    # 2. Correr los 5 filtros
    passed, direction, reason = run_all_filters(candles)

    if not passed:
        log.info(f"Trade saltado — filtro falló: {reason}")
        return

    log.info(f"Todos los filtros pasaron — dirección: {direction.upper()}")

    # 3. Buscar el mercado activo en Polymarket
    market = find_active_market(window_ts)
    if not market:
        log.error("No se encontró el mercado activo en Polymarket.")
        return

    token_id = market["tokens"][direction]

    # 4. Verificar probabilidad actual en el mercado
    prob = get_market_probability(token_id)
    if prob < MIN_PROBABILITY:
        log.info(f"Probabilidad {prob:.1%} < mínimo {MIN_PROBABILITY:.1%} — trade cancelado.")
        return

    log.info(f"Probabilidad: {prob:.1%}  →  Entrando trade ${CAPITAL_PER_TRADE}")

    # 5. Colocar la orden
    result = place_buy_order(
        token_id=token_id,
        amount_usdc=CAPITAL_PER_TRADE,
        price=prob
    )

    if result:
        log.info(f"Orden colocada exitosamente: {result}")
    else:
        log.error("Error colocando la orden.")


if __name__ == "__main__":
    run()
