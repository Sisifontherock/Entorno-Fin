import requests
import logging

log = logging.getLogger(__name__)

BASE_URL = "https://api.binance.com/api/v3"


def get_candles_1m(symbol: str = "BTCUSDT", limit: int = 5) -> list | None:
    """
    Devuelve las últimas `limit` velas de 1 minuto.
    Cada vela: [openTime, open, high, low, close, volume, ...]
    """
    try:
        resp = requests.get(
            f"{BASE_URL}/klines",
            params={"symbol": symbol, "interval": "1m", "limit": limit + 1},
            timeout=5
        )
        resp.raise_for_status()
        candles = resp.json()
        # Descartamos la vela actual (incompleta) y tomamos las anteriores
        return candles[:-1][-limit:]

    except requests.RequestException as e:
        log.error(f"Error Binance API: {e}")
        return None
